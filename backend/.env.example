# Copia este archivo a `.env` y sustituye los valores reales.
# Nunca se deben subir secretos reales a git (`.env` está en .gitignore).

# ---- PostgreSQL / PostGIS ----
DB_HOST=localhost
DB_PORT=5432
DB_USER=tu_usuario
DB_PASSWORD=cambia_por_tu_password
DB_NAME=seguridad_vial_db

# ---- Backend ----
PORT=3000

# ---- OSM/Overpass ----
# Contacto público que viaja en el User-Agent hacia la Overpass API
# (https://overpass-api.de). No es un secreto: Overpass exige un User-Agent
# identificable por su política de uso; sin esto puede rechazar o limitar
# las consultas (406/timeout). Ver SPEC-osm.md.
OSM_CONTACT_EMAIL=tu_email@ejemplo.com