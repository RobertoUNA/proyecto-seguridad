# =============================================================================
# EJEMPLO INSEGURO — solo para demostrar el rechazo de policy/container.rego (Ítem 3.4).
# NO se construye ni se despliega. Viola la Política 2 (usuario no root explícito):
#   la etapa final no declara USER, por lo que el proceso correría como root (THR-05).
# =============================================================================
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build
# Un USER en la etapa de build no protege la imagen final.
USER node

FROM node:22-alpine
WORKDIR /app
COPY --from=build /app/dist ./dist
EXPOSE 3000
CMD ["node", "dist/main.js"]
